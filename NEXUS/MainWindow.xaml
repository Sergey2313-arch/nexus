<Window
    x:Class="NEXUS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXUS"
    Title="NEXUS">

    <Grid Background="#0F1115">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="295"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================= -->
        <!--       ЛЕВОЕ МЕНЮ          -->
        <!-- ========================= -->

        <Border Grid.Column="0"
                Background="#181A1F"
                BorderBrush="#2B2E35"
                BorderThickness="0,0,1,0">

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="NEXUS"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="5,25,0,35"/>

                <StackPanel Grid.Row="1"
                            Spacing="12">

                    <Button Content="Dashboard"
                            Height="50"
                            HorizontalAlignment="Stretch"
                            Click="DashboardButton_Click"/>

                    <Button Content="Devices"
                            Height="50"
                            HorizontalAlignment="Stretch"/>

                    <Button Content="Planner"
                            Height="50"
                            HorizontalAlignment="Stretch"/>

                    <Button Content="Logbook"
                            Height="50"
                            HorizontalAlignment="Stretch"
                            Click="LogbookButton_Click"/>

                    <Button Content="Maintenance"
                            Height="50"
                            HorizontalAlignment="Stretch"/>

                    <Button Content="AI Assistant"
                            Height="50"
                            HorizontalAlignment="Stretch"/>

                    <Button Content="Settings"
                            Height="50"
                            HorizontalAlignment="Stretch"/>

                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="NEXUS v0.0.7"
                           Foreground="#80848C"
                           Margin="5,15"/>

            </Grid>
        </Border>

        <!-- ========================= -->
        <!--      ОСНОВНАЯ ОБЛАСТЬ     -->
        <!-- ========================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхние вкладки -->

            <Border Grid.Row="0"
                    Background="#202228"
                    BorderBrush="#2B2E35"
                    BorderThickness="0,0,0,1">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="15,0"
                            Spacing="10">

                    <Button Content="Dashboard"
                            Click="DashboardButton_Click"/>
                    <Button Content="Logbook"
                            Click="LogbookButton_Click"/>
                    <Button Content="Planner"/>
                    <Button Content="AI"/>

                </StackPanel>

            </Border>

            <!-- ========================= -->
            <!--         DASHBOARD         -->
            <!-- ========================= -->

            <ScrollViewer x:Name="DashboardView"
                          Grid.Row="1">

                <StackPanel Margin="38"
                            Spacing="25">

                    <!-- Заголовок -->

                    <StackPanel>

                        <TextBlock Text="Dashboard"
                                   FontSize="36"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Состояние системы NEXUS"
                                   FontSize="16"
                                   Foreground="#9A9DA5"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                    <!-- ========================= -->
                    <!--         УСТРОЙСТВО         -->
                    <!-- ========================= -->

                    <Border Background="#181A1F"
                            BorderBrush="#2B2E35"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="7">

                                <TextBlock x:Name="DeviceNameText"
                                           Text="PC"
                                           FontSize="25"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="OsNameText"
                                           Text="Windows"
                                           Foreground="#999DA5"/>

                                <TextBlock Text="NEXUS Agent connected"
                                           Foreground="#72D572"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#18351F"
                                    CornerRadius="8"
                                    Padding="16,8"
                                    VerticalAlignment="Top">

                                <TextBlock Text="● ONLINE"
                                           Foreground="#67D17A"
                                           FontWeight="Bold"/>

                            </Border>

                        </Grid>

                    </Border>

                    <!-- ========================= -->
                    <!--       CPU / RAM / DISK    -->
                    <!-- ========================= -->

                    <Grid ColumnSpacing="18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU -->

                        <Border Grid.Column="0"
                                Background="#181A1F"
                                BorderBrush="#2B2E35"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="CPU"
                                           Foreground="#9A9DA5"/>

                                <TextBlock x:Name="CpuValueText"
                                           Text="0%"
                                           FontSize="32"
                                           FontWeight="Bold"/>

                                <ProgressBar x:Name="CpuProgress"
                                             Value="0"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"/>

                                <TextBlock x:Name="CpuNameText"
                                           Text="CPU"
                                           Foreground="#73777F"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <!-- RAM -->

                        <Border Grid.Column="1"
                                Background="#181A1F"
                                BorderBrush="#2B2E35"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="RAM"
                                           Foreground="#9A9DA5"/>

                                <TextBlock x:Name="RamValueText"
                                           Text="0 GB"
                                           FontSize="32"
                                           FontWeight="Bold"/>

                                <ProgressBar x:Name="RamProgress"
                                             Value="0"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"/>

                                <TextBlock x:Name="RamDetailsText"
                                           Text="0 / 0 GB"
                                           Foreground="#73777F"
                                           FontSize="12"/>

                            </StackPanel>

                        </Border>

                        <!-- DISK C -->

                        <Border Grid.Column="2"
                                Background="#181A1F"
                                BorderBrush="#2B2E35"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="DISK C:"
                                           Foreground="#9A9DA5"/>

                                <TextBlock x:Name="DiskValueText"
                                           Text="0%"
                                           FontSize="32"
                                           FontWeight="Bold"/>

                                <ProgressBar x:Name="DiskProgress"
                                             Value="0"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"/>

                                <TextBlock x:Name="DiskDetailsText"
                                           Text="0 / 0 GB"
                                           Foreground="#73777F"
                                           FontSize="12"/>

                                <TextBlock x:Name="DiskStatusText"
                                           Text="Проверка..."
                                           Foreground="#9A9DA5"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- ========================= -->
                    <!--     CPU TEMP / GPU        -->
                    <!-- ========================= -->

                    <Grid ColumnSpacing="18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU TEMPERATURE -->

                        <Border Grid.Column="0"
                                Background="#181A1F"
                                BorderBrush="#2B2E35"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="CPU TEMPERATURE"
                                           Foreground="#9A9DA5"/>

                                <TextBlock x:Name="CpuTempText"
                                           Text="-- °C"
                                           FontSize="32"
                                           FontWeight="Bold"/>

                                <ProgressBar x:Name="CpuTempProgress"
                                             Value="0"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"/>

                                <TextBlock x:Name="CpuTempStatusText"
                                           Text="Получение данных..."
                                           Foreground="#73777F"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <!-- GPU -->

                        <Border Grid.Column="1"
                                Background="#181A1F"
                                BorderBrush="#2B2E35"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="10">

                                <TextBlock Text="GPU"
                                           Foreground="#9A9DA5"/>

                                <TextBlock x:Name="GpuLoadText"
                                           Text="--%"
                                           FontSize="32"
                                           FontWeight="Bold"/>

                                <ProgressBar x:Name="GpuProgress"
                                             Value="0"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"/>

                                <TextBlock x:Name="GpuNameText"
                                           Text="Поиск видеокарты..."
                                           Foreground="#73777F"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="GpuTempText"
                                           Text="Температура: -- °C"
                                           Foreground="#73777F"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- ========================= -->
                    <!--         SSD HEALTH        -->
                    <!-- ========================= -->

                    <Border Background="#181A1F"
                            BorderBrush="#2B2E35"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24">

                        <StackPanel Spacing="18">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="5">

                                    <TextBlock Text="SSD HEALTH"
                                               Foreground="#9A9DA5"/>

                                    <TextBlock x:Name="StorageNameText"
                                               Text="Поиск накопителя..."
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                                <TextBlock x:Name="StorageStatusText"
                                           Grid.Column="1"
                                           Text="Проверка..."
                                           Foreground="#9A9DA5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                            </Grid>

                            <Grid ColumnSpacing="25"
                                  RowSpacing="15">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- TEMP -->

                                <StackPanel Grid.Column="0"
                                            Grid.Row="0"
                                            Spacing="4">

                                    <TextBlock Text="Температура"
                                               Foreground="#73777F"/>

                                    <TextBlock x:Name="StorageTempText"
                                               Text="-- °C"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                                <!-- HEALTH -->

                                <StackPanel Grid.Column="1"
                                            Grid.Row="0"
                                            Spacing="4">

                                    <TextBlock Text="Остаточный ресурс"
                                               Foreground="#73777F"/>

                                    <TextBlock x:Name="StorageHealthText"
                                               Text="--%"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                                <!-- USED LIFE -->

                                <StackPanel Grid.Column="2"
                                            Grid.Row="0"
                                            Spacing="4">

                                    <TextBlock Text="Ресурс использован"
                                               Foreground="#73777F"/>

                                    <TextBlock x:Name="StorageLifeUsedText"
                                               Text="--%"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                                <!-- HOURS -->

                                <StackPanel Grid.Column="0"
                                            Grid.Row="1"
                                            Spacing="4">

                                    <TextBlock Text="Время работы"
                                               Foreground="#73777F"/>

                                    <TextBlock x:Name="StoragePowerOnText"
                                               Text="-- ч"
                                               FontSize="18"/>

                                </StackPanel>

                                <!-- CYCLES -->

                                <StackPanel Grid.Column="1"
                                            Grid.Row="1"
                                            Spacing="4">

                                    <TextBlock Text="Включений"
                                               Foreground="#73777F"/>

                                    <TextBlock x:Name="StoragePowerCyclesText"
                                               Text="--"
                                               FontSize="18"/>

                                </StackPanel>

                                <!-- SPACE -->

                                <StackPanel Grid.Column="2"
                                            Grid.Row="1"
                                            Spacing="4">

                                    <TextBlock Text="Накопитель"
                                               Foreground="#73777F"/>

                                    <TextBlock x:Name="StorageSpaceText"
                                               Text="-- / -- GB"
                                               FontSize="18"/>

                                </StackPanel>

                            </Grid>

                            <TextBlock x:Name="StorageIoText"
                                       Text="Прочитано: -- | Записано: --"
                                       Foreground="#73777F"
                                       FontSize="12"/>

                        </StackPanel>

                    </Border>

                    <!-- ========================= -->
                    <!--      UPTIME / EVENT       -->
                    <!-- ========================= -->

                    <Grid ColumnSpacing="18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- UPTIME -->

                        <Border Grid.Column="0"
                                Background="#181A1F"
                                BorderBrush="#2B2E35"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="8">

                                <TextBlock Text="UPTIME"
                                           Foreground="#9A9DA5"/>

                                <TextBlock x:Name="UptimeText"
                                           Text="00:00:00"
                                           FontSize="28"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Система работает стабильно"
                                           Foreground="#73777F"/>

                            </StackPanel>

                        </Border>

                        <!-- LAST EVENT -->

                        <Border Grid.Column="1"
                                Background="#181A1F"
                                BorderBrush="#2B2E35"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">

                            <StackPanel Spacing="8">

                                <TextBlock Text="ПОСЛЕДНЕЕ СОБЫТИЕ"
                                           Foreground="#9A9DA5"/>

                                <TextBlock x:Name="LastEventText"
                                           Text="NEXUS started"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="LastEventTimeText"
                                           Text="System"
                                           Foreground="#73777F"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

            <!-- ========================= -->
            <!--          LOGBOOK          -->
            <!-- ========================= -->

            <Grid x:Name="LogbookView"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Logbook"
                                   FontSize="36"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Бортовой журнал NEXUS"
                                   FontSize="16"
                                   Foreground="#9A9DA5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <ToggleSwitch x:Name="LiveToggle"
                                      Header="LIVE"
                                      IsOn="True"/>

                        <Button Content="Обновить"
                                Click="RefreshLogbookButton_Click"/>
                    </StackPanel>

                </Grid>

                <!-- Фильтры -->
                <Border Grid.Row="1"
                        Background="#181A1F"
                        BorderBrush="#2B2E35"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,18">

                    <Grid ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CategoryFilterComboBox"
                                  PlaceholderText="Категория"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Все"/>
                            <ComboBoxItem Content="Программы"/>
                            <ComboBoxItem Content="Процессы"/>
                            <ComboBoxItem Content="Файлы"/>
                            <ComboBoxItem Content="Буфер обмена"/>
                            <ComboBoxItem Content="Система"/>
                        </ComboBox>

                        <TextBox x:Name="LogbookSearchBox"
                                 Grid.Column="1"
                                 PlaceholderText="Поиск по журналу..."/>

                    </Grid>

                </Border>

                <!-- Основная область -->
                <Grid Grid.Row="2"
                      ColumnSpacing="18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Запущенные процессы -->
                    <Border Grid.Column="0"
                            Background="#181A1F"
                            BorderBrush="#2B2E35"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,12"
                                        Spacing="4">

                                <TextBlock Text="СЕЙЧАС ЗАПУЩЕНО"
                                           Foreground="#9A9DA5"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="RunningProcessesCountText"
                                           Text="0 процессов"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                            </StackPanel>

                            <ListView x:Name="RunningProcessesList"
                                      Grid.Row="1"
                                      SelectionMode="None">

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,7"
                                              ColumnSpacing="10">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Details}"
                                                           Foreground="#73777F"
                                                           FontSize="11"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Memory}"
                                                       Foreground="#9A9DA5"
                                                       VerticalAlignment="Center"/>

                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>

                            </ListView>

                        </Grid>

                    </Border>

                    <!-- История -->
                    <Border Grid.Column="1"
                            Background="#181A1F"
                            BorderBrush="#2B2E35"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ИСТОРИЯ"
                                           Foreground="#9A9DA5"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="LogbookCountText"
                                           Grid.Column="1"
                                           Text="0 событий"
                                           Foreground="#73777F"/>

                            </Grid>

                            <ListView x:Name="LogbookList"
                                      Grid.Row="1"
                                      SelectionMode="None">

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2B2E35"
                                                BorderThickness="0,0,0,1"
                                                Padding="2,10">

                                            <StackPanel Spacing="4">

                                                <Grid ColumnSpacing="10">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Time}"
                                                               Foreground="#9A9DA5"
                                                               FontFamily="Consolas"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Category}"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Source}"
                                                               Foreground="#73777F"
                                                               TextTrimming="CharacterEllipsis"/>

                                                </Grid>

                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding Details}"
                                                           Foreground="#9A9DA5"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="#73777F"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           TextWrapping="Wrap"/>

                                            </StackPanel>

                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>

                            </ListView>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>