<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NEXUS palette -->
    <Color x:Key="NexusBackgroundColor">#0B0D11</Color>
    <Color x:Key="NexusSurfaceColor">#15181E</Color>
    <Color x:Key="NexusSurfaceAltColor">#111419</Color>
    <Color x:Key="NexusBorderColor">#272C35</Color>
    <Color x:Key="NexusTextPrimaryColor">#F2F4F8</Color>
    <Color x:Key="NexusTextSecondaryColor">#9A9FA9</Color>
    <Color x:Key="NexusAccentColor">#4C7DFF</Color>
    <Color x:Key="NexusAccentHoverColor">#5B89FF</Color>
    <Color x:Key="NexusDangerColor">#FF6B6B</Color>
    <Color x:Key="NexusSuccessColor">#67D17A</Color>
    <Color x:Key="NexusWarningColor">#F4C95D</Color>

    <SolidColorBrush x:Key="NexusBackgroundBrush" Color="{StaticResource NexusBackgroundColor}"/>
    <SolidColorBrush x:Key="NexusSurfaceBrush" Color="{StaticResource NexusSurfaceColor}"/>
    <SolidColorBrush x:Key="NexusSurfaceAltBrush" Color="{StaticResource NexusSurfaceAltColor}"/>
    <SolidColorBrush x:Key="NexusBorderBrush" Color="{StaticResource NexusBorderColor}"/>
    <SolidColorBrush x:Key="NexusTextPrimaryBrush" Color="{StaticResource NexusTextPrimaryColor}"/>
    <SolidColorBrush x:Key="NexusTextSecondaryBrush" Color="{StaticResource NexusTextSecondaryColor}"/>
    <SolidColorBrush x:Key="NexusAccentBrush" Color="{StaticResource NexusAccentColor}"/>
    <SolidColorBrush x:Key="NexusAccentHoverBrush" Color="{StaticResource NexusAccentHoverColor}"/>
    <SolidColorBrush x:Key="NexusDangerBrush" Color="{StaticResource NexusDangerColor}"/>
    <SolidColorBrush x:Key="NexusSuccessBrush" Color="{StaticResource NexusSuccessColor}"/>
    <SolidColorBrush x:Key="NexusWarningBrush" Color="{StaticResource NexusWarningColor}"/>

    <!-- Global controls -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="11,7"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style TargetType="CalendarDatePicker">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <!-- Explicit styles used by runtime-built pages -->
    <Style x:Key="NexusPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NexusAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="NexusSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NexusSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NexusTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NexusBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>

    <Style x:Key="NexusDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#3A1D20"/>
        <Setter Property="Foreground" Value="#FFB3B3"/>
        <Setter Property="BorderBrush" Value="#5C2A2F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>

</ResourceDictionary>
